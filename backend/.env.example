# 复制为 backend/.env 并改成你的真实配置(.env 不入库)
# 连接串格式:mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://sakiblog:sakiblog@localhost:3306/sakiblog

# 启动时自动建表(开发用;生产关闭,交由迁移工具)
AUTO_CREATE_TABLES=true

# 会话 Cookie 签名密钥;生产环境务必换成随机长字符串(如 openssl rand -hex 32)
SECRET_KEY=dev-secret-change-me

# 允许跨域的前端来源(JSON 数组)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
